        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-danger text-white">
                        <h4 class="mb-0">Доступ запрещен</h4>
                    </div>
                    <div class="card-body text-center">
                        <div class="mb-4">
                            <span style="font-size: 80px;">🚫</span>
