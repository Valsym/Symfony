{% extends 'base.html.twig' %}

{% block title %}Список пользователей{% endblock %}

{% block content %}
    <h1>Список пользователей.</h1>
    <ul>
        {% for user in users %}
            <li>{{ user|capitalize }}</li>
        {% else %}
            <li>Пользователи не найдены.</li>
        {% endfor %}
    </ul>
{% endblock %}
