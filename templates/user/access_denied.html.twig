                        <p class="lead">{{ message }}</p>
                        <p class="text-muted">Пожалуйста, обратитесь к администратору для получения доступа.</p>
                        <a href="{{ path('app_product_index') }}" class="btn btn-primary">Вернуться на главную</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
